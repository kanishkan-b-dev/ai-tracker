# ==============================================================================
# Render.com & Production Key Vault Configuration
# Matches all keys configured in your Render Key Vault / Environment Variables
# ==============================================================================

# 1. Core Django Security & Environment
SECRET_KEY=your-production-secret-key-here
DEBUG=False
PYTHON_VERSION=3.14.0

# 2. Key Vault User Credentials (strictly 2 production users)
HEALTHCHECK_ADMIN_USERNAME=kanishkan
USER_1_USERNAME=kanishkan
USER_1_PASSWORD=Kanishkan@2004
USER_2_USERNAME=preetha
USER_2_PASSWORD=Preetha@2005
# Or comma-separated format:
# RENDER_USERS=kanishkan:Kanishkan@2004:admin,preetha:Preetha@2005:user

# 3. Host & Domain Routing
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,ai-learning-tracker.onrender.com
# Optional manual CSRF origins (automatically derived from ALLOWED_HOSTS & HEALTHCHECK_APPLICATION_URL if omitted)
# CSRF_TRUSTED_ORIGINS=https://ai-learning-tracker.onrender.com,http://localhost:8000

# 4. Database URL (Render PostgreSQL or Supabase PostgreSQL)
# Format: postgresql://[user]:[password]@[hostname]:[port]/[database]
# If unset or commented out, SQLite (db.sqlite3) is automatically used locally.
# DATABASE_URL=postgresql://postgres:yourpassword@db.xyz.supabase.co:5432/postgres

# 5. Redis Caching & Queue URL (Render Redis or Upstash)
# If set, Django Cache uses Redis. If unset, uses high-speed local memory cache.
# REDIS_URL=redis://red-xxxx:6379

# 6. Health Check & Uptime Diagnostics
# Endpoint: /health/ and /healthcheck/
HEALTHCHECK_APPLICATION_URL=https://ai-learning-tracker.onrender.com
HEALTHCHECK_TIME_ZONE=UTC

# 7. Supabase Storage & Services Integration
# Used for storing uploaded resumes, documents, and media attachments persistently.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=resumes

# 8. Optional Email Service
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
